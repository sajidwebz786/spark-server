PORT=5000
CLIENT_URLS=https://hrms.infolinx.com,https://www.hrms.infolinx.com
ADMIN_PORTAL_URL=https://hrms.infolinx.com
USER_PORTAL_URL=https://hrms.infolinx.com
CANDIDATE_PORTAL_URL=https://hrms.infolinx.com
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_NAME=hrmsdb
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_DIALECT=postgres
# Preferred for local connection to Render Postgres:
# DATABASE_URL=postgresql://user:password@external-render-host/database
# DB_SSL=true
# Render enables PostgreSQL TLS automatically, even when DB_SSL is unset.
# For a private database CA, provide its PEM certificate (literal \n accepted):
# DB_SSL_CA=
# Certificate verification is enabled by default.
# DB_SSL_REJECT_UNAUTHORIZED=true
# Google Workspace Gmail API (service account with domain-wide delegation)
MAIL_MODE=google
GOOGLE_SERVICE_ACCOUNT_FILE=./google-mail-service-account.json
GOOGLE_MAIL_SENDER=hr@sparkinfosol.com
GOOGLE_MAIL_FROM_NAME=HR-Department
MAIL_FROM=hr@sparkinfosol.com
HR_ADMIN_EMAIL=hr@sparkinfosol.com
COMPANY_EMAIL_DOMAIN=sparkinfosol.com
# Optional SMTP alternative: MAIL_MODE=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Keep Graph credentials below only if Microsoft Teams is still used.
JWT_DEMO_SECRET=replace-this-before-production

# Microsoft Graph / Teams integration
MS_GRAPH_TENANT_ID=your-azure-tenant-id
MS_GRAPH_CLIENT_ID=your-azure-app-client-id
MS_GRAPH_CLIENT_SECRET=your-azure-app-client-secret
MS_GRAPH_USER_ID=hr-or-scheduler-user@yourcompany.com

# Google Calendar integration
GOOGLE_CALENDAR_ID=primary-or-shared-calendar-id
GOOGLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
